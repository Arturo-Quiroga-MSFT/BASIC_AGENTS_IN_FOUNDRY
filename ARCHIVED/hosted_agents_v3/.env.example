# ============================================================================
# REQUIRED FOR LOCAL TESTING
# ============================================================================

# Azure OpenAI Configuration (Required for agent.py)
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini

# Azure AI Foundry Project (Required for Foundry tools)
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Optional: Foundry Tool Connection ID (for MCP tools)
# AZURE_AI_PROJECT_TOOL_CONNECTION_ID=your-tool-connection-id

# ============================================================================
# REQUIRED FOR DEPLOYMENT
# ============================================================================

# Azure Subscription and Resource Group
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group

# Azure Foundry Account and Project Names
AZURE_FOUNDRY_ACCOUNT_NAME=your-account-name
AZURE_PROJECT_NAME=your-project-name

# ============================================================================
# REQUIRED FOR DOCKER BUILD AND PUSH
# ============================================================================

# Azure Container Registry
ACR_NAME=myregistry
ACR_LOGIN_SERVER=myregistry.azurecr.io
IMAGE_NAME=myagent
IMAGE_TAG=v1

# Full container image path (update after pushing to ACR)
CONTAINER_IMAGE=myregistry.azurecr.io/myagent:v1

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

# Agent Name and Version
AGENT_NAME=my-hosted-agent
AGENT_VERSION=1

# Model Configuration (for deployment)
MODEL_NAME=gpt-4o-mini

# ============================================================================
# OPTIONAL - OBSERVABILITY
# ============================================================================

# Application Insights (optional - for tracing)
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-appinsights-connection-string

# Agent Project Resource ID (optional)
# AGENT_PROJECT_RESOURCE_ID=/subscriptions/{sub}/resourceGroups/{rg}/providers/Microsoft.MachineLearningServices/workspaces/{project}
