# Hosted Agent Environment Variables
# Copy this file to .env and fill in your values

# Required
OPENWEATHER_API_KEY=your_openweather_api_key_here
AZURE_AI_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com

# Optional
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=INFO

# Agent Configuration
AGENT_NAME=WeatherAgent
AGENT_VERSION=2
AGENT_DESCRIPTION=Weather agent with real OpenWeatherMap API integration

# Bot Service Authentication (required for production)
# MICROSOFT_APP_ID=your_app_id
# MICROSOFT_APP_PASSWORD=your_app_password

# Application Insights (optional, for monitoring)
# APPLICATIONINSIGHTS_CONNECTION_STRING=your_connection_string
